# Discard inherited relative/empty PATH entries before any startup code runs.
# This also secures exec zsh when launched from an older shell configuration.
path=("${(@M)path:#/*}")

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git gitfast last-working-dir common-aliases history-substring-search ssh-agent colored-man-pages zsh-autosuggestions zsh-syntax-highlighting)
zstyle :omz:plugins:ssh-agent honor-existing yes
zstyle :omz:plugins:ssh-agent lazy yes

setopt EXTENDED_HISTORY          # Write the history file in the ':start:elapsed;command' format.
setopt INC_APPEND_HISTORY        # Write to the history file immediately, not when the shell exits.
setopt SHARE_HISTORY             # Share history between all sessions.
setopt HIST_EXPIRE_DUPS_FIRST    # Expire a duplicate event first when trimming history.
setopt HIST_IGNORE_DUPS          # Do not record an event that was just recorded again.
setopt HIST_IGNORE_SPACE         # Do not record an event starting with a space.
setopt HIST_SAVE_NO_DUPS         # Do not write a duplicate event to the history file.
setopt APPEND_HISTORY            # append to history file
# Maximum lines kept in memory
export HISTSIZE=50000
# Maximum lines saved to $HISTFILE
export SAVEHIST=500000

setopt ignoreeof
export HOMEBREW_NO_ANALYTICS=1
# Keep completion permission checks enabled, even if inherited from an old shell.
unset ZSH_DISABLE_COMPFIX
# Bootstrap installs fixed commits; updates are an explicit maintenance action.
zstyle ':omz:update' mode disabled

# Homebrew may be installed outside the system PATH on a fresh login.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"
unalias rm 2>/dev/null
[[ -f "$HOME/.custom_commands.sh" ]] && source "$HOME/.custom_commands.sh"
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"

typeset -U path
# Project bin directories belong in explicit project commands (e.g. npm exec).
# Do not add them to global PATH: shell startup runs optional runtime commands.
path=("$HOME/.local/bin" "$HOME/.rbenv/bin" "$HOME/.pyenv/bin" "$HOME/.opencode/bin" "$HOME/.dotnet/tools" "$HOME/go/bin" $path)
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init - zsh)"
if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init - zsh)"
  if pyenv commands | command grep -qx virtualenv-init; then eval "$(pyenv virtualenv-init -)"; fi
fi
export BUNDLE_FORCE_RUBY_PLATFORM=true
export BUNDLER_EDITOR=code
export EDITOR=vim
export LANG=${LANG:-en_US.UTF-8}
export LC_ALL=en_US.UTF-8

export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
elif command -v brew >/dev/null 2>&1; then
  nvm_prefix="$(brew --prefix)/opt/nvm"
  [[ -s "$nvm_prefix/nvm.sh" ]] && source "$nvm_prefix/nvm.sh"
  unset nvm_prefix
fi
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

if [[ "$(uname -s)" == Darwin ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  export DOTNET_ROOT=/usr/local/share/dotnet
  for optional_bin in /usr/local/mysql/bin "$DOTNET_ROOT" "$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools"; do
    [[ -d "$optional_bin" ]] && path+=("$optional_bin")
  done
  if command -v brew >/dev/null 2>&1; then
    for optional_bin in "$(brew --prefix)/opt/openjdk@17/bin" "$(brew --prefix)/opt/openvpn/sbin"; do
      [[ -d "$optional_bin" ]] && path+=("$optional_bin")
    done
  fi
  unset optional_bin
fi

[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"
# Keep the existing optional Google Cloud and OpenCode integrations portable.
[[ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]] && source "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"
[[ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ]] && source "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"
true
